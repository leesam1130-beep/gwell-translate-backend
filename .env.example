# 复制成 .env 后填入真实值
# 真实的 .env 永远不要 commit 到 git；Railway 上请在 Variables 面板里配置

OPENAI_API_KEY=sk-your-openai-api-key-here

# 可选：本地调试端口（Railway 会自动注入 PORT）
PORT=3000

# 可选：换成自建 OpenAI 兼容代理 / Azure
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# 用户名白名单 (可选, 推荐 phase-2 启用)
# ============================================================
# 留空 / 不设置 → 任何请求都放行（phase-1：插件即装即用，无需登录）
# 填上逗号分隔的用户名列表 → 必须在白名单内才允许调用翻译接口（phase-2：按用户名校验）
#
# 切换 phase 只需在 Railway 修改这里 → Redeploy，插件端 0 改动。
# 用户名建议用纯英文/数字，避免空格和特殊字符。
#
# 例：开放 3 个销售员：
# GWELL_ALLOWED_USERS=alice,bob,charlie
#
# GWELL_ALLOWED_USERS=

# ============================================================
# Token 节流（服务端硬限制，与插件版本无关）
# ============================================================
# 这些上限不动也能跑（已经设了合理默认值）。如果你发现 input token 还是偏高，
# 可以在 Railway 改这里 → Redeploy，立刻生效，不需要改插件。
#
# /api/translate（中→客户语言）
#   MAX_CUSTOMER_MSGS    客户最近消息保留多少条          默认 5  范围 0-50
#   MAX_CUSTOMER_MSG_LEN 单条客户消息最大字符数          默认 400 范围 50-4000
#
# /api/batch-translate-incoming（来信批量→中文）
#   MAX_BATCH_CONTEXT    recentContext 保留多少条        默认 5  范围 0-30
#   MAX_BATCH_CTX_LEN    单条 recentContext 最大字符数   默认 200 范围 50-2000
#   MAX_BATCH_ITEM_LEN   单条来信 item.text 最大字符数   默认 800 范围 50-4000
#
# 想再激进一点压成本，可以这样设：
# MAX_CUSTOMER_MSGS=3
# MAX_CUSTOMER_MSG_LEN=300
# MAX_BATCH_CONTEXT=3
