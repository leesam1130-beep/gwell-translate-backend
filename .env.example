# ===================================================================
# GWELL Translate Backend — 环境变量样例
# 本地开发：复制本文件为 .env 并填入真实值
# Railway 部署：在 Railway 控制台 → Variables 页面逐个添加
# ===================================================================

# ===================================================================
# Provider 选择
# ===================================================================
# 默认：Gemini 当主，OpenAI 当容灾备份。两个都可以填；任一可单独跑（少一个就没容灾）。
#   GWELL_PRIMARY_PROVIDER=gemini  → 默认请求 Gemini，Gemini 失败/被 SAFETY 拒答时自动切 OpenAI
#   GWELL_PRIMARY_PROVIDER=openai  → 反过来：OpenAI 主，Gemini 备
# 客户端也可以在请求里直接指定 model（如 "gpt-4o-mini" / "gemini-2.0-flash"）来强制走某 provider。
GWELL_PRIMARY_PROVIDER=gemini

# 必填（至少一个）：API Keys
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-google-ai-studio-api-key-here

# 可选：默认 Gemini 模型（GWELL_PRIMARY_PROVIDER=gemini 时生效）
#   gemini-2.0-flash       — 推荐，最新平衡款，比 gpt-4o-mini 便宜 33%
#   gemini-1.5-flash       — 上一代成熟，便宜 50%
#   gemini-1.5-flash-8b    — 最便宜（便宜 75%），质量稍弱，适合短翻译
GWELL_GEMINI_MODEL=gemini-2.0-flash

# 可选：OpenAI 兼容网关地址（默认 https://api.openai.com/v1）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：Gemini 网关地址（默认 https://generativelanguage.googleapis.com）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 可选：本地开发端口（Railway 会自动注入 PORT，部署时无需设置）
PORT=3000

# 可选：用户名白名单（逗号分隔）。空 = 完全放行；填了 = 只允许这些用户名
# 例：GWELL_ALLOWED_USERS=alice,bob,charlie
GWELL_ALLOWED_USERS=

# 可选：默认翻译模式
#   slim   (默认) — 短 prompt，省 token
#   expert         — 长 prompt 回退（仅在发现 slim 翻译质量下降时切换）
GWELL_TRANSLATE_DEFAULT_MODE=slim

# 可选：是否允许调用昂贵模型（gpt-4o, gpt-4.1, o1 等）
#   未设置 / "false" (默认推荐) — 后端拒绝接受这些模型，自动降级到 gpt-4o-mini
#                                  即使 Chrome 插件传了 model:"gpt-4o" 也会被忽略
#                                  典型每日费用从 $1.55 降到 $0.10 量级
#   "true"                       — 完全放行，按客户端请求执行
# 默认 false。需要紧急/高质量场景再开。
GWELL_ALLOW_PREMIUM_MODELS=false
