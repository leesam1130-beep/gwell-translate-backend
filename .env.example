# ===================================================================
# GWELL Translate Backend — 环境变量样例
# 本地开发：复制本文件为 .env 并填入真实值
# Railway 部署：在 Railway 控制台 → Variables 页面逐个添加
# ===================================================================

# 必填：OpenAI API Key（仅服务端持有，插件端不再保留）
OPENAI_API_KEY=sk-your-openai-api-key-here

# 可选：OpenAI 兼容网关地址（默认 https://api.openai.com/v1）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：本地开发端口（Railway 会自动注入 PORT，部署时无需设置）
PORT=3000

# 可选：用户名白名单（逗号分隔）。空 = 完全放行；填了 = 只允许这些用户名
# 例：GWELL_ALLOWED_USERS=alice,bob,charlie
GWELL_ALLOWED_USERS=

# 可选：默认翻译模式
#   slim   (默认) — 短 prompt，省 token
#   expert         — 长 prompt 回退（仅在发现 slim 翻译质量下降时切换）
GWELL_TRANSLATE_DEFAULT_MODE=slim
